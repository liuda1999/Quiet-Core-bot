// Default signing values for shared/repo builds.
// Auto-selected local team overrides live in .local-signing.xcconfig (git-ignored).
// Manual local overrides can go in LocalSigning.xcconfig (git-ignored).

#include "Config/Version.xcconfig"

QUIET_CORE_CODE_SIGN_STYLE = Manual
QUIET_CORE_CODE_SIGN_IDENTITY = Apple Development
QUIET_CORE_CODE_SIGN_ENTITLEMENTS = Sources/QuietCore.entitlements
QUIET_CORE_DEVELOPMENT_TEAM = FWJYW4S8P8

QUIET_CORE_APP_BUNDLE_ID = ai.quiet-core-botfoundation.app
QUIET_CORE_SHARE_BUNDLE_ID = ai.quiet-core-botfoundation.app.share
QUIET_CORE_APP_GROUP_ID = group.ai.quiet-core-botfoundation.app.shared
QUIET_CORE_WATCH_APP_BUNDLE_ID = ai.quiet-core-botfoundation.app.watchkitapp
QUIET_CORE_ACTIVITY_WIDGET_BUNDLE_ID = ai.quiet-core-botfoundation.app.activitywidget
QUIET_CORE_APNS_ENTITLEMENT_ENVIRONMENT = development

QUIET_CORE_APP_PROFILE = ai.quiet-core-botfoundation.app Development
QUIET_CORE_SHARE_PROFILE = ai.quiet-core-botfoundation.app.share Development
QUIET_CORE_ACTIVITY_WIDGET_PROFILE =
QUIET_CORE_WATCH_APP_PROFILE =

// Keep local includes after defaults: xcconfig is evaluated top-to-bottom,
// so later assignments in local files override the defaults above.
#include? ".local-signing.xcconfig"
#include? "LocalSigning.xcconfig"
