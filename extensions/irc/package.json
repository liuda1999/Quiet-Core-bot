{
  "name": "@quiet-core/irc",
  "version": "0.1.3",
  "description": "QuietCore IRC channel plugin",
  "type": "module",
  "devDependencies": {
    "@quiet-core/plugin-sdk": "workspace:*"
  },
  "quiet-core-bot": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "clawhubSpec": "clawhub:@quiet-core/irc",
      "npmSpec": "@quiet-core/irc",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.6.9",
      "allowInvalidConfigRecovery": true
    },
    "setupEntry": "./setup-entry.ts",
    "channel": {
      "id": "irc",
      "label": "IRC",
      "selectionLabel": "IRC (Server + Nick)",
      "detailLabel": "IRC",
      "docsPath": "/channels/irc",
      "docsLabel": "irc",
      "blurb": "classic IRC networks with DM/channel routing and pairing controls.",
      "aliases": [
        "internet-relay-chat"
      ],
      "cliAddOptions": [
        {
          "flags": "--host <host>",
          "description": "IRC server host"
        },
        {
          "flags": "--port <port>",
          "description": "IRC server port (defaults to 6697, or 6667 with --no-tls)"
        },
        {
          "flags": "--nick <nick>",
          "description": "IRC nick"
        },
        {
          "flags": "--username <name>",
          "description": "IRC username"
        },
        {
          "flags": "--realname <name>",
          "description": "IRC real name"
        },
        {
          "flags": "--tls",
          "description": "Use a TLS connection"
        },
        {
          "flags": "--no-tls",
          "description": "Disable TLS (uses port 6667 by default)"
        }
      ],
      "systemImage": "network",
      "configuredState": {
        "env": {
          "allOf": [
            "IRC_HOST",
            "IRC_NICK"
          ]
        },
        "specifier": "./configured-state",
        "exportName": "hasIrcConfiguredState"
      }
    },
    "compat": {
      "pluginApi": ">=0.1.0"
    },
    "build": {
      "openclawVersion": "0.1.3",
      "bundledDist": false
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/liuda1999/Quiet-Core-bot"
  }
}
