{
  "name": "@quiet-core/nostr",
  "version": "0.1.2",
  "description": "QuietCore Nostr channel plugin for NIP-04 encrypted direct messages.",
  "repository": {
    "type": "git",
    "url": "https://github.com/liuda1999/Quiet-Core-bot"
  },
  "type": "module",
  "dependencies": {
    "nostr-tools": "2.25.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@quiet-core/plugin-sdk": "workspace:*",
    "quiet-core-bot": "workspace:*"
  },
  "peerDependencies": {
    "quiet-core-bot": ">=0.1.0"
  },
  "peerDependenciesMeta": {
    "quiet-core-bot": {
      "optional": true
    }
  },
  "quiet-core-bot": {
    "extensions": [
      "./index.ts"
    ],
    "setupEntry": "./setup-entry.ts",
    "channel": {
      "id": "nostr",
      "label": "Nostr",
      "selectionLabel": "Nostr (NIP-04 DMs)",
      "docsPath": "/channels/nostr",
      "docsLabel": "nostr",
      "blurb": "Decentralized protocol; encrypted DMs via NIP-04.",
      "order": 55,
      "quickstartAllowFrom": true,
      "cliAddOptions": [
        {
          "flags": "--private-key <key>",
          "description": "Nostr private key (nsec... or hex)"
        },
        {
          "flags": "--relay-urls <list>",
          "description": "Nostr relay URLs (comma-separated)"
        }
      ]
    },
    "install": {
      "npmSpec": "@quiet-core/nostr",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.4.10"
    },
    "compat": {
      "pluginApi": ">=0.1.0"
    },
    "build": {
      "openclawVersion": "0.1.2"
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}
