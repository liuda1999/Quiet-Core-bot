{
  "name": "@quiet-core/acpx",
  "version": "0.1.2",
  "description": "QuietCore ACP runtime backend with plugin-owned session and transport management.",
  "repository": {
    "type": "git",
    "url": "https://github.com/liuda1999/Quiet-Core-bot"
  },
  "type": "module",
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.39.0",
    "@zed-industries/codex-acp": "0.15.0",
    "acpx": "0.11.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@quiet-core/plugin-sdk": "workspace:*"
  },
  "quiet-core-bot": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "npmSpec": "@quiet-core/acpx",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.4.25"
    },
    "compat": {
      "pluginApi": ">=0.1.0"
    },
    "build": {
      "openclawVersion": "0.1.2",
      "staticAssets": [
        {
          "source": "./src/runtime-internals/mcp-proxy.mjs",
          "output": "mcp-proxy.mjs"
        },
        {
          "source": "./src/runtime-internals/mcp-command-line.mjs",
          "output": "mcp-command-line.mjs"
        }
      ]
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true,
      "bundleRuntimeDependencies": false
    }
  }
}
