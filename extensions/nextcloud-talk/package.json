{
  "name": "@quiet-core/nextcloud-talk",
  "version": "0.1.0",
  "description": "QuietCore Nextcloud Talk channel plugin for conversations.",
  "repository": {
    "type": "git",
    "url": "https://github.com/liuda1999/Quiet-Core-bot"
  },
  "type": "module",
  "devDependencies": {
    "@quiet-core/plugin-sdk": "workspace:*",
    "quiet-core-bot": "workspace:*"
  },
  "peerDependencies": {
    "quiet-core-bot": ">=0.1.0"
  },
  "peerDependenciesMeta": {
    "quiet-core-bot": {
      "optional": true
    }
  },
  "quiet-core-bot": {
    "extensions": [
      "./index.ts"
    ],
    "setupEntry": "./setup-entry.ts",
    "channel": {
      "id": "nextcloud-talk",
      "label": "Nextcloud Talk",
      "selectionLabel": "Nextcloud Talk (self-hosted)",
      "docsPath": "/channels/nextcloud-talk",
      "docsLabel": "nextcloud-talk",
      "blurb": "Self-hosted chat via Nextcloud Talk webhook bots.",
      "aliases": [
        "nc-talk",
        "nc"
      ],
      "order": 65,
      "quickstartAllowFrom": true
    },
    "install": {
      "npmSpec": "@quiet-core/nextcloud-talk",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.4.10"
    },
    "compat": {
      "pluginApi": ">=0.1.0"
    },
    "build": {
      "openclawVersion": "0.1.0"
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  },
  "dependencies": {
    "zod": "4.4.3"
  }
}
