    {
      "name": "@quiet-core/firecrawl-plugin",
      "description": "QuietCore Firecrawl plugin.",
      "source": "official",
      "kind": "plugin",
      "quiet-core-bot": {
        "plugin": {
          "id": "firecrawl",
          "label": "Firecrawl"
        },
        "contracts": {
          "webFetchProviders": [
            "firecrawl"
          ],
          "webSearchProviders": [
            "firecrawl"
          ],
          "tools": [
            "firecrawl_search",
            "firecrawl_scrape"
          ]
        },
        "webSearchProviders": [
          {
            "id": "firecrawl",
            "label": "Firecrawl Search",
            "hint": "Structured results with optional result scraping",
            "onboardingScopes": [
              "text-inference"
            ],
            "credentialLabel": "Firecrawl API key",
            "envVars": [
              "FIRECRAWL_API_KEY"
            ],
            "placeholder": "fc-...",
            "signupUrl": "https://www.firecrawl.dev/",
            "docsUrl": "https://github.com/liuda1999/Quiet-Core-bot/tools/firecrawl",
            "credentialPath": "plugins.entries.firecrawl.config.webSearch.apiKey",
            "autoDetectOrder": 60
          }
        ],
        "install": {
          "clawhubSpec": "clawhub:@quiet-core/firecrawl-plugin",
          "npmSpec": "@quiet-core/firecrawl-plugin",
          "defaultChoice": "npm",
          "minHostVersion": ">=2026.6.8"
        }
      }
    },
