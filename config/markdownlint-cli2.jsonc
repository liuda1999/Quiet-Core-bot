{
  "globs": ["docs/**/*.md", "docs/**/*.mdx", "README.md"],
  "ignores": ["docs/zh-CN/**", "docs/.i18n/**", "docs/reference/templates/**", "**/.local/**"],
  "config": {
    "default": true,

    "MD013": false,
    "MD025": false,
    "MD029": false,

    "MD033": {
      "allowed_elements": [
        "Note",
        "Info",
        "Tip",
        "Warning",
        "Card",
        "CardGroup",
        "Columns",
        "Steps",
        "Step",
        "Tabs",
        "Tab",
        "Accordion",
        "AccordionGroup",
        "CodeGroup",
        "Frame",
        "Callout",
        "ParamField",
        "ResponseField",
        "RequestExample",
        "ResponseExample",
        "img",
        "a",
        "br",
        "table",
        "tr",
        "td",
        "details",
        "summary",
        "p",
        "div",
        "strong",
        "span",
        "iframe",
        "h1",
        "h2",
        "h3",
        "picture",
        "source",
        "sub",
        "Tooltip",
        "Check",
      ],
    },

    "MD036": false,
    "MD040": false,
    "MD041": false,
    "MD046": false,

    // Table pipe alignment is owned by oxfmt (`pnpm format:docs:check`), which pads
    // columns by display width. MD060 counts characters, so for tables containing
    // full-width CJK characters the two rules cannot both be satisfied; the
    // formatter wins.
    "MD060": false,
  },
}
